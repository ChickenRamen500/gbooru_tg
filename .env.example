# Telegram bot token from @BotFather
BOT_TOKEN=your_bot_token_here

# Gelbooru API credentials (https://gelbooru.com/index.php?page=account&s=options)
GELBOORU_API_KEY=your_gelbooru_api_key
GELBOORU_USER_ID=your_gelbooru_user_id

# Telegram user ID of the bot owner (for admin commands)
OWNER_ID=your_telegram_user_id

# Cloudflare Worker URL that proxies Gelbooru images (adds Referer header).
# REQUIRED: Telegram blocks direct Gelbooru URLs. Without this, thumbnails will show as grey squares.
# Create a Worker at https://dash.cloudflare.com/?to=/:account/workers-and-pages
# See README.md for step-by-step instructions.
# Example: PUBLIC_URL=https://gelbooru-proxy.yourname.workers.dev
PUBLIC_URL=
