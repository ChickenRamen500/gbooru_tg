```gitignore
# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Logs and temp files
*.log
*.tmp

# Environment
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/

# Dependencies
.venv/
venv/
pip-log.txt
pip-selfcheck.json

# Coverage
.coverage
coverage/
htmlcov/

# Testing
.pytest_cache/
.mypy_cache/
.hypothesis/

# Distribution / packaging
dist/
build/
*.egg-info/
.eggs/

# OS generated files
.DS_Store
Thumbs.db
```